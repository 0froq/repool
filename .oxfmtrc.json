{
  "semi": false,
  "singleQuote": true,
  "arrowParens": "avoid",
  "quoteProps": "consistent",
  "singleAttributePerLine": true,
  "htmlWhitespaceSensitivity": "strict",
  "ignorePatterns": [
    ".nuxt/**",
    ".output/**",
    "dist/**",
    "public/**",
    "pnpm-lock.yaml",
    "vendor/ui/**",
    "AGENTS.md"
  ]
}
